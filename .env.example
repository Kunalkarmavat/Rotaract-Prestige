# Public URL of the deployed site (used for SEO + sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where club photos live. Default is the old GitHub Pages site.
# After copying photos into /public/images, set this to /images
NEXT_PUBLIC_IMAGE_BASE=https://kunalkarmavat.github.io/Rotaract_Prestige.github.io/images

# Optional: a Formspree (or similar) endpoint so the contact form sends
# straight to your inbox. Leave empty to fall back to the visitor's email app.
NEXT_PUBLIC_FORM_ENDPOINT=
